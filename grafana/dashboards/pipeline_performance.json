{
  "id": null,
  "uid": "welding-pipeline-performance",
  "title": "Welding Digital Twin - Pipeline Performance",
  "tags": [
    "Welding Digital Twin",
    "Operational Test"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Producer vs Consumer Throughput (Messages/sec)",
      "description": "Compares the message sending rate with the successfully processed message rate.",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "rate(welding_producer_messages_sent_total[1m])",
          "instant": false,
          "refId": "A",
          "legendFormat": "Producer Sent - {{topic}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "rate(welding_consumer_messages_processed_total[1m])",
          "instant": false,
          "refId": "B",
          "legendFormat": "Consumer Processed - {{topic}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Simulation Processing Progress",
      "description": "Compares the latest simulation time produced with the latest simulation time persisted by the Consumer.",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "welding_producer_current_sim_time_seconds",
          "instant": false,
          "refId": "A",
          "legendFormat": "Producer Sim Time"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "welding_consumer_last_sim_time_seconds",
          "instant": false,
          "refId": "B",
          "legendFormat": "Consumer - {{topic}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Estimated Unprocessed Messages",
      "description": "Estimated difference between total messages sent and successfully processed. This is not actual Kafka consumer lag.",
      "type": "stat",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(welding_producer_messages_sent_total) - sum(welding_consumer_messages_processed_total)",
          "instant": false,
          "refId": "A",
          "legendFormat": "Estimated Difference"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 100
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Python Process Memory Usage (Bytes)",
      "description": "Resident memory used by the instrumented Python processes. This is not total container memory.",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "process_resident_memory_bytes",
          "instant": false,
          "refId": "A",
          "legendFormat": "{{job}} Memory"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}